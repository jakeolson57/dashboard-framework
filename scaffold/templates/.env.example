# Copy to .env on Unraid and fill in. Never commit .env.
PORT={{PORT}}
DB_PATH=/data/{{DB_FILE}}

# GitHub OAuth ("Log in with GitHub"). Empty = login disabled (reads stay public on tailnet).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://{{SIDECAR_HOST}}.{{TAILNET}}.ts.net:{{SIDECAR_PORT}}/api/oauth/callback
